<local:ViewBase x:Class="IPBanManager.Wpf.Views.UpdatesView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:IPBanManager.Wpf.Views">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16" MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Text="Atualizações" FontSize="22" FontWeight="Bold" Margin="0,0,0,12"/>

            <Border x:Name="UnsupportedBanner" Background="#FFF4CE" BorderBrush="#E6C200" BorderThickness="1" Padding="10" Margin="0,0,0,12" Visibility="Collapsed">
                <TextBlock x:Name="UnsupportedText" TextWrapping="Wrap" Foreground="#5C4A00"/>
            </Border>

            <GroupBox Header="Versão instalada" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock FontSize="16">
                        <Run Text="IPBan Manager " FontWeight="SemiBold"/>
                        <Run x:Name="VersionText" Text="-"/>
                        <Run x:Name="ChannelText" Foreground="#666"/>
                    </TextBlock>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                               Text="As atualizações preservam suas configurações e dados (ipban.config, preferências e logs ficam fora da pasta do programa)."/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Canal de atualização" Margin="0,0,0,10">
                <StackPanel>
                    <RadioButton x:Name="StableRadio" GroupName="Channel" Margin="0,2" Checked="Settings_Changed"
                                 Content="Stable (recomendado): somente versões estáveis e testadas"/>
                    <RadioButton x:Name="BetaRadio" GroupName="Channel" Margin="0,2" Checked="Settings_Changed"
                                 Content="Beta: recebe versões de teste antecipadas (podem conter falhas)"/>
                    <CheckBox x:Name="AutoCheck" Margin="0,10,0,2" Click="Settings_Changed"
                              Content="Verificar atualizações automaticamente em segundo plano"/>
                    <CheckBox x:Name="AutoDownload" Margin="0,2" Click="Settings_Changed"
                              Content="Baixar automaticamente (a instalação sempre pede confirmação)"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Verificar e instalar" Margin="0,0,0,10">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="CheckButton" Content="Verificar agora" Style="{StaticResource PrimaryButton}" Click="Check_Click"/>
                        <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextWrapping="Wrap" Text="-"/>
                    </StackPanel>
                    <ProgressBar x:Name="Progress" Height="8" Margin="0,10,0,0" Minimum="0" Maximum="100" Visibility="Collapsed"/>

                    <Border x:Name="AvailablePanel" BorderBrush="#CCC" BorderThickness="1" Padding="10" Margin="0,12,0,0" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="AvailableTitle" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="Novidades:" Style="{StaticResource FieldLabel}" Margin="0,8,0,2"/>
                            <TextBox x:Name="NotesBox" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="160" MinHeight="48"
                                     VerticalScrollBarVisibility="Auto"/>
                            <Button x:Name="InstallButton" Content="Baixar e instalar" Margin="0,10,0,0" HorizontalAlignment="Left"
                                    Style="{StaticResource PrimaryButton}" Click="Install_Click"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </GroupBox>

            <GroupBox x:Name="RollbackBox" Header="Voltar à versão anterior" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="RollbackText" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <Button Content="Reverter" HorizontalAlignment="Left" Click="Rollback_Click"/>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                               Text="Se uma versão nova falhar ao iniciar, o aplicativo reverte sozinho para a anterior e não oferece essa versão novamente."/>
                </StackPanel>
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
</local:ViewBase>
