<Window x:Class="IPBanManager.Wpf.Views.IPBanSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:IPBanManager.Wpf.Views"
        Title="IPBan Manager - Instalação do IPBan" Width="640" Height="660" MinWidth="520" MinHeight="540"
        Icon="pack://application:,,,/app.ico" WindowStartupLocation="CenterOwner" ShowInTaskbar="True" Closing="Window_Closing">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="InstallButton" Content="Instalar" MinWidth="110" IsDefault="True" Click="Install_Click"/>
            <Button x:Name="CloseButton" Content="Cancelar" MinWidth="110" IsCancel="True" Click="Close_Click"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Top">
            <TextBlock x:Name="HeadingText" FontSize="20" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <TextBlock x:Name="DescriptionText" TextWrapping="Wrap" Margin="0,0,0,12"/>
            <TextBlock Style="{StaticResource FieldLabel}" Text="Whitelist: IPs que nunca serão bloqueados"/>
            <local:EntryListEditor x:Name="WhitelistBox" Kind="Address" Height="150" PlaceholderText="ex.: 203.0.113.10"/>
            <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,4,0,12"
                       Text="Preenchido com o endereço da sua conexão de Área de Trabalho Remota. Inclua também outros IPs fixos de administração (escritório, VPN). Aceita IP, faixa CIDR (203.0.113.0/24) ou nome DNS."/>
            <TextBlock Style="{StaticResource FieldLabel}" Text="Andamento"/>
        </StackPanel>
        <TextBox x:Name="ProgressBox" IsReadOnly="True" Style="{StaticResource Mono}" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" Background="#FAFAFA"/>
    </DockPanel>
</Window>
