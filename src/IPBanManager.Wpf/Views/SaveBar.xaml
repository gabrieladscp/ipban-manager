<UserControl x:Class="IPBanManager.Wpf.Views.SaveBar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:IPBanManager.Wpf.Views">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
        <Button x:Name="SaveButton" Style="{StaticResource PrimaryButton}" Content="Salvar (Ctrl+S)" Click="Save_Click"
                ToolTip="Valida e grava no ipban.config"/>
        <Button Content="Recarregar" Click="Reload_Click" ToolTip="Descarta alterações e lê o arquivo novamente"/>
        <TextBlock Text="● Alterações não salvas" Foreground="#B45F06" FontWeight="SemiBold" VerticalAlignment="Center"
                   Visibility="{Binding IsDirty, RelativeSource={RelativeSource AncestorType=local:EditableViewBase}, Converter={StaticResource BoolToVis}}"/>
    </StackPanel>
</UserControl>
