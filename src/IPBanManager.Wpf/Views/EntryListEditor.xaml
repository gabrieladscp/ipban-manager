<UserControl x:Class="IPBanManager.Wpf.Views.EntryListEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <Grid DockPanel.Dock="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid>
                <TextBox x:Name="Input" Style="{StaticResource Mono}" Height="28" Padding="4,3"
                         AcceptsReturn="False" TextWrapping="NoWrap" VerticalScrollBarVisibility="Disabled"
                         PreviewTextInput="Input_PreviewTextInput" PreviewKeyDown="Input_PreviewKeyDown"
                         TextChanged="Input_TextChanged"/>
                <TextBlock x:Name="Placeholder" IsHitTestVisible="False" Margin="8,0,0,0" VerticalAlignment="Center"
                           Foreground="#999" FontStyle="Italic"/>
            </Grid>
            <Button x:Name="AddButton" Grid.Column="1" Content="+" Width="34" MinWidth="0" Height="28" Margin="6,0,0,0" Padding="0"
                    FontSize="16" FontWeight="Bold" IsEnabled="False" Click="Add_Click" ToolTip="Adicionar (Enter)"/>
            <Button x:Name="RemoveButton" Grid.Column="2" Content="−" Width="34" MinWidth="0" Height="28" Margin="4,0,0,0" Padding="0"
                    FontSize="16" FontWeight="Bold" IsEnabled="False" Click="Remove_Click" ToolTip="Remover os selecionados (Delete)"/>
        </Grid>
        <TextBlock x:Name="Message" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="2,3,0,3" MinHeight="16" FontSize="11.5"/>
        <TextBlock x:Name="CountText" DockPanel.Dock="Bottom" Foreground="#666" FontSize="11.5" Margin="2,3,0,0"/>
        <ListBox x:Name="Items" Style="{x:Null}" SelectionMode="Extended" FontFamily="Consolas" FontSize="13"
                 SelectionChanged="Items_SelectionChanged" KeyDown="Items_KeyDown"/>
    </DockPanel>
</UserControl>
